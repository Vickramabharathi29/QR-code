SUPABASE_URL=https://tjfhuulhzvlkqvjkevki.supabase.co
# Place your rotated Supabase server-side service-role key below.
# Under Row Level Security (RLS), privileged backend database writes require this key.
SUPABASE_KEY=your-supabase-service-role-key-here

# Administrator Account Configuration (Supabase Auth)
ADMIN_EMAIL=Vickramabharathi@gmail.com
ADMIN_INITIAL_PASSWORD=your-secure-admin-initial-password-here

# Application Settings
APP_ENV=development
DEBUG=True
PORT=8501

# URL Analyzer Settings
URL_TIMEOUT_SECONDS=10
MAX_REDIRECTS=10

# Reinforcement Learning Settings
RL_LEARNING_RATE=0.1
RL_DISCOUNT_FACTOR=0.95
